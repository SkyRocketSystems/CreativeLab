---
interface Props {
  product?: 'tote' | 'organizador' | 'decorativo';
  color?: string;
  material?: 'lona' | 'lienzo' | 'impermeable' | 'premium';
  stateful?: boolean;
  etiqueta?: string;
}

const {
  product = 'tote',
  color = '#E6DEC9',
  material = 'lona',
  stateful = false,
  etiqueta = 'Vista previa del producto',
} = Astro.props;
---

<div
  class:list={['mockup', { stateful }]}
  data-product={product}
  data-material={material}
  data-pocket="off"
  data-label="off"
  data-pos="centro"
  data-fuente="moderna"
  data-colortexto="carbon"
  style={`--fabric:${color}`}
  role="img"
  aria-label={etiqueta}
>
  <div class="mockup-stage">
    <svg
      viewBox="0 0 400 440"
      fill="none"
      shape-rendering="geometricPrecision"
      text-rendering="geometricPrecision"
      aria-hidden="true"
    >
      <ellipse
        cx="200"
        cy="422"
        rx="146"
        ry="13"
        fill="rgba(30,26,24,.30)"
        filter="url(#difuminado)"></ellipse>

      <!-- ============ TOTE BAG ============ -->
      <g class="p-tote">
        <path
          d="M168 132 C168 70 232 70 232 132"
          stroke="var(--fabric-darker)"
          stroke-width="13"
          stroke-linecap="round"></path>
        <path
          class="cuerpo"
          d="M80 132 L320 132 L308 404 Q306 416 294 416 L106 416 Q94 416 92 404 Z"
          fill="var(--fabric)"></path>
        <path
          class="cuerpo tex"
          d="M80 132 L320 132 L308 404 Q306 416 294 416 L106 416 Q94 416 92 404 Z"></path>
        <path
          class="cuerpo"
          d="M80 132 L320 132 L308 404 Q306 416 294 416 L106 416 Q94 416 92 404 Z"
          fill="url(#sombra-v)"></path>
        <path
          class="cuerpo"
          d="M80 132 L320 132 L308 404 Q306 416 294 416 L106 416 Q94 416 92 404 Z"
          fill="url(#sombra-h)"></path>
        <path d="M80 132 L320 132 L317.5 160 L82.5 160 Z" fill="var(--fabric-dark)"></path>
        <path d="M88 170 L312 170" stroke="var(--stitch)" stroke-width="1.8" stroke-dasharray="6 5"></path>
        <path
          d="M94 180 L306 180 L296 402 Q294 406 288 406 L112 406 Q106 406 104 402 Z"
          stroke="var(--stitch)"
          stroke-width="1.8"
          stroke-dasharray="6 5"></path>
        <path d="M104 388 Q200 398 296 388" stroke="rgba(30,26,24,.10)" stroke-width="2"></path>
        <path
          d="M146 132 C146 58 254 58 254 132"
          stroke="var(--fabric-dark)"
          stroke-width="14"
          stroke-linecap="round"></path>
        <path
          d="M148 128 C148 64 252 64 252 128"
          stroke="rgba(250,248,243,.20)"
          stroke-width="4"
          stroke-linecap="round"></path>
        <g class="p-pocket">
          <rect
            x="212"
            y="310"
            width="96"
            height="78"
            rx="10"
            fill="var(--fabric-pocket)"
            stroke="rgba(30,26,24,.20)"
            stroke-width="1.5"></rect>
          <rect
            x="220"
            y="322"
            width="80"
            height="58"
            rx="6"
            fill="none"
            stroke="var(--stitch)"
            stroke-width="1.6"
            stroke-dasharray="5 4"></rect>
          <path d="M212 328 L308 328" stroke="rgba(30,26,24,.16)" stroke-width="2"></path>
        </g>
        <g class="p-etiqueta" transform="rotate(-8 300 128)">
          <rect
            x="272"
            y="112"
            width="62"
            height="32"
            rx="7"
            fill="#FAF8F3"
            stroke="rgba(30,26,24,.28)"
            stroke-width="1.4"></rect>
          <rect x="282" y="122" width="26" height="4" rx="2" fill="#AD8470"></rect>
          <rect x="282" y="130" width="38" height="3" rx="1.5" fill="rgba(30,26,24,.25)"></rect>
          <path d="M272 118 L256 128" stroke="rgba(30,26,24,.30)" stroke-width="1.6" stroke-dasharray="3 3"></path>
        </g>
      </g>

      <!-- ============ ORGANIZADOR ============ -->
      <g class="p-organizador">
        <rect x="44" y="158" width="20" height="36" rx="10" fill="var(--fabric-darker)"></rect>
        <rect x="336" y="158" width="20" height="36" rx="10" fill="var(--fabric-darker)"></rect>
        <path
          class="cuerpo"
          d="M78 194 L322 194 L310 402 Q308 414 296 414 L104 414 Q92 414 90 402 Z"
          fill="var(--fabric)"></path>
        <path
          class="cuerpo tex"
          d="M78 194 L322 194 L310 402 Q308 414 296 414 L104 414 Q92 414 90 402 Z"></path>
        <path
          class="cuerpo"
          d="M78 194 L322 194 L310 402 Q308 414 296 414 L104 414 Q92 414 90 402 Z"
          fill="url(#sombra-v)"></path>
        <path
          class="cuerpo"
          d="M78 194 L322 194 L310 402 Q308 414 296 414 L104 414 Q92 414 90 402 Z"
