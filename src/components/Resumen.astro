---
import ProductMockup from './ProductMockup.astro';
---

<section class="seccion seccion-resumen" id="resumen" aria-label="Resumen de tu diseño">
  <div class="contenedor-1120">
    <p class="etiqueta-seccion etiqueta-resumen">Tu diseño</p>
    <h2>Tu diseño, listo para crear</h2>

    <div class="resumen-grid">
      <!-- Columna izquierda: elecciones -->
      <div class="resumen-tarjeta resumen-elecciones">
        <h3>Tus elecciones</h3>
        <div class="resumen-producto">
          <ProductMockup stateful={true} product="tote" color="#E6DEC9" etiqueta="Tu producto personalizado" />
        </div>
        <dl class="lista-elecciones">
          <div><dt>Producto</dt><dd id="val-producto">Tote bag</dd></div>
          <div><dt>Color</dt><dd id="val-color">Natural</dd></div>
          <div><dt>Material</dt><dd id="val-material">Lona de algodón reciclado</dd></div>
          <div><dt>Texto</dt><dd id="val-texto">Sin texto</dd></div>
          <div><dt>Tipografía</dt><dd id="val-fuente">Moderna</dd></div>
          <div><dt>Ubicación</dt><dd id="val-posicion">Centro</dd></div>
          <div><dt>Extras</dt><dd id="val-extras">Ninguno</dd></div>
        </dl>
      </div>

      <!-- Columna derecha: desglose y acciones -->
      <div class="resumen-tarjeta resumen-precio">
        <h3>Desglose del precio</h3>
        <dl class="desglose">
          <div class="desglose-fila">
            <dt>Precio base (<span id="d-base-nombre">Tote bag</span>)</dt>
            <dd id="d-base-val">$40.000</dd>
          </div>
          <div class="desglose-fila" id="fila-texto" hidden>
            <dt>Personalización de texto</dt>
            <dd>+$10.000</dd>
          </div>
          <div class="desglose-fila" id="fila-material" hidden>
            <dt id="d-material-nombre">Tela impermeable</dt>
            <dd id="d-material-val">+$8.000</dd>
          </div>
          <div class="desglose-fila" data-fila-extra="bolsillo" hidden>
            <dt>Bolsillo interior</dt>
            <dd>+$8.000</dd>
          </div>
          <div class="desglose-fila" data-fila-extra="etiqueta" hidden>
            <dt>Etiqueta personalizada</dt>
            <dd>+$5.000</dd>
          </div>
          <div class="desglose-fila" data-fila-extra="empaque" hidden>
            <dt>Empaque para regalo</dt>
            <dd>+$7.000</dd>
          </div>
          <div class="desglose-fila" data-fila-extra="tarjeta" hidden>
            <dt>Tarjeta con mensaje</dt>
            <dd>+$3.000</dd>
          </div>
          <div class="desglose-fila desglose-total">
            <dt>Total estimado</dt>
            <dd id="precio-resumen">$40.000 COP</dd>
          </div>
        </dl>

        <p class="nota">Cada producto pasa por control de calidad antes de ser elaborado.</p>
        <p class="nota">Tiempo estimado de elaboración y entrega: 5 a 8 días hábiles.</p>
        <p class="nota nota-destacada">El precio final se confirma antes de la elaboración.</p>

        <div class="resumen-acciones">
          <button class="btn btn-primario" data-accion="whatsapp" type="button">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 0 1 12 4Zm-3 4.4c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.2.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.1.7.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2-.1-.1-.2-.2-.5-.3l-1.7-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.1-.2 0-.4.1-.5l.6-.7c.1-.2.2-.3.3-.5v-.5L10 8.7c-.2-.4-.4-.3-.6-.3h-.4Z"></path>
            </svg>
            Pedir por WhatsApp
          </button>
          <button class="btn btn-borde" data-accion="guardar" type="button">Guardar mi diseño</button>
          <button class="btn btn-borde" data-accion="imprimir" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
              <path d="M6 9V3h12v6"></path>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect x="6" y="14" width="12" height="8" rx="1"></rect>
            </svg>
            Guardar en PDF
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .seccion-resumen {
    background: var(--beige);
  }

  .etiqueta-resumen {
    color: var(--taupe);
    display: block;
    margin-bottom: 8px;
  }

  .seccion-resumen h2 {
    margin-bottom: 32px;
  }

  .resumen-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 1080px) {
    .resumen-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  .resumen-tarjeta {
    background: var(--crema);
    border-radius: var(--radius-tarjeta);
    padding: 24px;
    box-shadow: var(--sombra-tarjeta);
  }

  .resumen-tarjeta h3 {
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .resumen-elecciones {
    display: flex;
    flex-direction: column;
  }

  .resumen-producto {
    background: linear-gradient(160deg, #f0eadb 0%, var(--beige) 100%);
    border-radius: 18px;
    padding: 16px;
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
  }

  .resumen-producto :global(.mockup) {
    width: min(50%, 200px);
  }

  .lista-elecciones {
    display: flex;
    flex-direction: column;
  }

  .lista-elecciones > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px dashed rgba(30, 26, 24, 0.16);
  }

  .lista-elecciones > div:last-child {
    border-bottom: none;
  }

  .lista-elecciones dt {
    font-size: 14px;
    color: rgba(30, 26, 24, 0.62);
    font-weight: 600;
  }

  .lista-elecciones dd {
    margin: 0;
    font-size: 14.5px;
    font-weight: 700;
    text-align: right;
  }

  .resumen-precio {
    display: flex;
    flex-direction: column;
  }

  .nota {
    font-size: 13.5px;
    color: rgba(30, 26, 24, 0.66);
    line-height: 1.5;
    margin-top: 12px;
  }

  .nota-destacada {
    font-weight: 700;
    color: var(--carbon);
  }

  .resumen-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  @media (min-width: 1080px) {
    .resumen-acciones .btn {
      flex: 1;
    }
  }
</style>

