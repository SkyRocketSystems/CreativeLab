---
interface Props {
  stateful?: boolean;
  etiqueta?: string;
}

const { stateful = false, etiqueta = 'Vista previa de tu tarjeta de regalo' } = Astro.props;
---

<div
  class:list={['tarjeta-regalo', { stateful }]}
  data-fuente="moderna"
  role="img"
  aria-label={etiqueta}
>
  <div class="tr-hoja" aria-hidden="true"></div>
  <div class="tr-cuerpo">
    <p class="tr-marca" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 20s-7-4.3-7-9a4 4 0 0 1 7-2.5A4 4 0 0 1 19 11c0 4.7-7 9-7 9Z"></path>
      </svg>
      <span>CreativeLab</span>
    </p>

    <p class="tr-dedicatoria tr-para">
      <span class="tr-etiqueta">Para</span>
      <span class="tr-valor" data-para></span>
    </p>

    <p class="tr-mensaje" data-mensaje></p>

    <p class="tr-dedicatoria tr-de">
      <span class="tr-etiqueta">De</span>
      <span class="tr-valor" data-de></span>
    </p>

    <div class="tr-pie">
      <p>
        Este regalo está hecho por el equipo de <strong>CreativeLab</strong>.<br />
        Un laboratorio de inclusión e impacto social.
      </p>
    </div>
  </div>
</div>

<style>
  /* Mockup de la tarjeta de regalo: hoja trasera rotada + cuerpo crema con
     costura interior punteada, dentro del sistema de diseño CreativeLab. */
  .tarjeta-regalo {
    --tr-fuente: var(--fuente-ui);
    position: relative;
    max-width: 300px;
    margin-inline: auto;
    padding: 8px 6px 14px 14px;
    container-type: inline-size;
  }

  .tarjeta-regalo[data-fuente='manuscrita'] {
    --tr-fuente: var(--fuente-manuscrita);
  }

  .tarjeta-regalo[data-fuente='clasica'] {
    --tr-fuente: var(--fuente-clasica);
  }

  .tr-hoja {
    position: absolute;
    inset: 8px 0 4px 18px;
    background: var(--beige);
    border: 1px solid var(--beige-linea);
    border-radius: 20px;
    transform: rotate(2.5deg);
  }

  .tr-cuerpo {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 9px;
    background: var(--crema);
    border: 1px solid var(--beige-linea);
    border-radius: 20px;
    padding: 16px 16px 13px;
    text-align: center;
    box-shadow: var(--sombra-tarjeta);
  }

  /* Costura interior punteada, como las prendas de CreativeLab */
  .tr-cuerpo::before {
    content: '';
    position: absolute;
    inset: 7px;
    border: 1.5px dashed rgba(30, 26, 24, 0.18);
    border-radius: 14px;
    pointer-events: none;
  }

  .tr-marca {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--taupe);
  }

  .tr-marca svg {
    width: 13px;
    height: 13px;
    color: var(--terracota);
  }

  .tr-dedicatoria {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 7px;
    min-width: 0;
    font-family: var(--tr-fuente);
  }

  .tr-etiqueta {
    font-family: var(--fuente-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--taupe);
  }

  .tr-valor {
    font-size: clamp(15px, 6.5cqw, 20px);
    font-weight: 600;
    line-height: 1.15;
    color: var(--carbon);
    overflow-wrap: anywhere;
  }

  .tarjeta-regalo[data-fuente='manuscrita'] .tr-valor {
    font-size: clamp(17px, 7.5cqw, 23px);
  }

  /* Línea en blanco mientras no se escribe el nombre */
  .tr-valor:empty::after {
    content: '________________';
    font-family: var(--fuente-ui);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: rgba(30, 26, 24, 0.25);
  }

  .tr-mensaje {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    font-family: var(--tr-fuente);
    font-size: clamp(14px, 6.5cqw, 19px);
    font-weight: 600;
    line-height: 1.3;
    color: var(--carbon);
    overflow-wrap: anywhere;
  }

  .tarjeta-regalo[data-fuente='manuscrita'] .tr-mensaje {
    font-size: clamp(17px, 8cqw, 23px);
  }

  .tr-mensaje:empty::before {
    content: 'Tu mensaje aparecerá aquí';
    font-family: var(--fuente-ui);
    font-size: 12.5px;
    font-style: italic;
    color: rgba(30, 26, 24, 0.35);
  }

  .tr-pie {
    margin-top: 2px;
    padding-top: 9px;
    border-top: 1px dashed rgba(30, 26, 24, 0.22);
  }

  .tr-pie p {
    font-size: 10.5px;
    line-height: 1.45;
    color: rgba(30, 26, 24, 0.6);
  }

  .tr-pie strong {
    font-weight: 700;
    color: var(--taupe);
  }
</style>
