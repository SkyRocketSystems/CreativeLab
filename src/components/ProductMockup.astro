        <path d="M96 210 L304 210" stroke="var(--stitch)" stroke-width="1.8" stroke-dasharray="6 5"></path>
        <path d="M138 214 L146 402" stroke="rgba(30,26,24,.08)" stroke-width="2"></path>
        <path d="M262 214 L254 402" stroke="rgba(30,26,24,.08)" stroke-width="2"></path>
        <g class="p-pocket">
          <rect
            x="212"
            y="306"
            width="96"
            height="76"
            rx="10"
            fill="var(--fabric-pocket)"
            stroke="rgba(30,26,24,.20)"
            stroke-width="1.5"></rect>
          <rect
            x="220"
            y="318"
            width="80"
            height="56"
            rx="6"
            fill="none"
            stroke="var(--stitch)"
            stroke-width="1.6"
            stroke-dasharray="5 4"></rect>
          <path d="M212 324 L308 324" stroke="rgba(30,26,24,.16)" stroke-width="2"></path>
        </g>
        <g class="p-etiqueta" transform="rotate(-6 300 150)">
          <rect
            x="282"
            y="138"
            width="58"
            height="30"
            rx="7"
            fill="#FAF8F3"
            stroke="rgba(30,26,24,.28)"
            stroke-width="1.4"></rect>
          <rect x="291" y="147" width="24" height="4" rx="2" fill="#AD8470"></rect>
          <rect x="291" y="155" width="36" height="3" rx="1.5" fill="rgba(30,26,24,.25)"></rect>
        </g>
