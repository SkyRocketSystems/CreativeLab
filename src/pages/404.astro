---
import Layout from '../layouts/Layout.astro';

/* Ruta base del despliegue (GitHub Pages: /<repo>) para volver al inicio */
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Layout title="Página no encontrada — CreativeLab">
  <main class="pagina-404">
    <p class="etiqueta">Error 404</p>
    <h1>Esta página se quedó en el taller</h1>
    <p class="texto">
      La dirección que buscas no existe o cambió de lugar. Vuelve al estudio y sigue creando.
    </p>
    <a class="btn btn-primario" href={`${base}/`}>Volver a crear →</a>
  </main>
</Layout>

<style>
  .pagina-404 {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 16px;
    max-width: 560px;
    margin-inline: auto;
    padding: 24px 16px;
  }

  .etiqueta {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--taupe);
  }

  h1 {
    font-size: 40px;
  }

  .texto {
    color: rgba(30, 26, 24, 0.7);
    max-width: 40ch;
  }
</style>
