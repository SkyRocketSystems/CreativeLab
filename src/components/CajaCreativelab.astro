---
// Página "Caja con Propósito" (prototipo convertido a componente).
// - Renderizada por src/pages/caja-creativelab.astro dentro de Layout.astro:
//   hereda el sistema de diseño compartido (tokens, tipografía Fraunces +
//   sistema, materiales translúcidos y movimiento de src/styles/global.css).
// - El bloque de estilo usa "is:global" porque el CSS original usa selectores
//   de documento que el scoping de Astro rompería; aquí solo queda la
//   composición propia de la página.
// - El bloque de script usa "is:inline" y conserva el JS original tal cual,
//   ejecutándose en su posición. Se renderiza en la URL: /caja-creativelab/.
---

<div class="strip">Preventa piloto · 30 cajas · Suscripción semestral o anual</div>
<header class="bar"><div class="nav">
  <div class="wm">CreativeLab</div>
  <nav><a href="#contenido">La caja</a><a href="#planes">Planes</a><a href="#impacto">Impacto</a><a href="#preventa">Preventa</a></nav>
  <button class="cbtncarrito" data-abrir-carrito="caja" type="button" aria-label="Caja, 0 planes">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 8h12l-1.2 12H7.2L6 8Z"></path>
      <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
    </svg>
    <span class="cbadge badge-carrito" data-ambito="caja" aria-hidden="true" hidden>0</span>
  </button>
</div></header>

<div class="hero"><div class="hero-in">
  <div>
    <div class="tagline">#CajaConPropósito</div>
    <h1>Cada caja trae una sorpresa para ti y una oportunidad para alguien más</h1>
    <p>Una suscripción de productos CreativeLab con diseño exclusivo cada mes. Parte de lo que pagas se destina a un aliado social, y te mostramos cuánto y para qué.</p>
    <a class="btn" href="#planes">Elegir mi plan</a><a class="btn alt" href="#preventa">Preventa</a>
  </div>
  <div class="stage weave">
    <button class="box" id="box" aria-label="Abrir la caja de muestra" aria-pressed="false">
      <div class="lid">CreativeLab</div>
      <div class="items"><div class="it">Producto</div><div class="it">Detalle</div><div class="it">Tarjeta</div></div>
      <div class="base"></div>
    </button>
    <div class="hint" id="hint">Toca la caja para abrirla</div>
  </div>
</div></div>

<section id="contenido">
  <h2>Una caja, cuatro capas</h2>
  <p class="lead">No es solo recibir una caja: es una experiencia de diseño, sorpresa e impacto.</p>
  <div class="bands">
    <div class="band weave"><h3>Producto principal</h3><ul><li>Una pieza de CreativeLab</li><li>Elaborada con talento local</li><li>Distinta cada mes</li></ul></div>
    <div class="band weave"><h3>Detalle adicional</h3><ul><li>La sorpresa de cada entrega</li><li>Pensado para acompañar el producto</li></ul></div>
    <div class="band weave"><h3>Diseño y empaque</h3><ul><li>Diseño exclusivo del mes</li><li>Empaque especial</li><li>Ediciones limitadas</li></ul></div>
    <div class="band weave"><h3>Historia e impacto</h3><ul><li>Tarjeta con la historia del producto</li><li>Información del impacto social</li><li>Código QR al proyecto o fundación</li></ul></div>
  </div>
</section>

<section id="planes" style="padding-top:8px">
  <h2>Elige tu caja</h2>
  <p class="lead">Precios piloto por caja; la suscripción es semestral o anual y recibes una caja cada mes. Se ajustarán cuando estén cotizados los costos reales de producción, empaque, materiales y logística.</p>
  <div class="toggle" role="group" aria-label="Duración">
    <button data-f="Semestral" aria-pressed="true">Semestral · 6 cajas</button>
    <button data-f="Anual" aria-pressed="false">Anual · 12 cajas</button>
  </div>
  <div class="plans" id="plans"></div>
  <p class="note" id="sel" style="margin-top:18px"></p>
  <button class="btn" id="suscribir" type="button" style="margin-top:18px">Suscribirme y pagar →</button>
</section>

<section>
  <h2>Así se hace tu caja</h2>
  <p class="lead">Del taller a tu casa, con el impacto a la vista.</p>
  <ol class="steps">
    <li><b>Escoges un plan</b><span>Esencial, Plus o Premium, con compromiso semestral o anual.</span></li>
    <li><b>Pagas tu suscripción</b><span>Pago del periodo o recurrente, por la tienda digital o WhatsApp.</span></li>
    <li><b>Recibes tu caja</b><span>Con producto, diseño del mes, tarjeta y QR.</span></li>
    <li><b>Conoces el impacto</b><span>Te contamos cuánto aportaste y qué se logró.</span></li>
  </ol>
  <div class="story"><b>Tarjeta de historia (ejemplo)</b><div class="note" style="margin-top:6px">Aquí irá el nombre de quien elaboró tu producto, dónde y cómo nació. Cada caja incluye una tarjeta distinta.</div></div>
</section>

<section id="impacto">
  <h2>Calcula el impacto</h2>
  <p class="lead">Ajusta los valores y mira cuánto llegaría al aliado social.</p>
  <div class="calc">
    <div>
      <label for="n">Suscripciones: <span id="nv">100</span></label>
      <input type="range" id="n" min="20" max="500" step="10" value="100">
      <label for="cp">Plan</label>
      <select id="cp"><option value="0">Esencial</option><option value="1" selected>Plus</option><option value="2">Premium</option></select>
      <label for="cm">Modelo de aporte</label>
      <select id="cm"><option value="fijo" selected>Monto fijo por plan</option><option value="pct">10 % de cada suscripción</option></select>
    </div>
    <div>
      <div class="note">Aporte al aliado social por entrega</div>
      <div class="big" id="tot">$0</div>
      <div class="stat"><span>Ingresos por entrega</span><span id="rev">$0</span></div>
      <div class="stat"><span>Aporte por caja</span><span id="per">$0</span></div>
      <div class="stat"><span>Porcentaje del precio</span><span id="pc">0%</span></div>
      <div class="msg" id="msg"></div>
    </div>
  </div>
</section>

<section>
  <h2>Un aliado por temporada</h2>
  <p class="lead">Trabajamos con una sola fundación cada temporada y publicamos cuánto se recaudó y en qué se usó.</p>
  <div class="causes">
    <div class="cause weave"><b>Inclusión</b><span>Personas con discapacidad.</span></div>
    <div class="cause weave"><b>Educación</b><span>Acceso y permanencia.</span></div>
    <div class="cause weave"><b>Empleabilidad</b><span>Oportunidades laborales.</span></div>
    <div class="cause weave"><b>Jóvenes</b><span>En situación de vulnerabilidad.</span></div>
    <div class="cause weave"><b>Familias</b><span>En situación de vulnerabilidad.</span></div>
    <div class="cause weave"><b>Ambiente</b><span>Protección ambiental.</span></div>
  </div>
  <p class="note" style="margin-top:16px">Reporte de impacto: suscripciones del periodo, monto aportado, uso del dinero, personas vinculadas, productos elaborados y empresas vinculadas.</p>
</section>

<section id="preventa" style="padding-top:8px">
  <div class="pre weave">
    <div>
      <h2>Preventa piloto</h2>
      <p>Solo 30 cajas. Medimos cuántas personas quieren continuar para decidir el siguiente paso.</p>
      <div class="track" role="progressbar" aria-valuemin="0" aria-valuemax="30" aria-valuenow="12"><i id="bar"></i></div>
      <div id="cnt" style="font-weight:700">12 de 30 cajas reservadas</div>
      <div class="note" style="color:var(--carbon)">Cifra de demostración.</div>
    </div>
    <div class="f">
      <input id="nm" placeholder="Nombre" autocomplete="name" aria-label="Nombre">
      <input id="ct" placeholder="WhatsApp o correo" aria-label="Contacto">
      <select id="pp" aria-label="Plan"><option>Esencial</option><option selected>Plus</option><option>Premium</option></select>
      <button class="btn" id="go" style="width:100%">Reservar mi caja</button>
      <div class="ok" id="ok" role="status"></div>
      <div class="note" id="er" style="margin-top:10px;color:var(--carbon);font-weight:700"></div>
    </div>
  </div>
</section>

<footer><div class="wm">CreativeLab</div><div class="n">Prototipo de propuesta comercial</div></footer>

<style is:global>
/* Sistema compartido: tokens, tipografía (Fraunces + sistema), materiales y
   movimiento provienen de src/styles/global.css vía Layout. Aquí solo vive la
   composición propia de la página de la caja. */
section{padding:68px 20px;max-width:1120px;margin:0 auto}
h2{font-size:clamp(30px,6vw,46px);margin-bottom:12px}
.lead{color:var(--carbon-60);max-width:56ch;margin:0 0 34px;font-size:17px}
.strip{background:var(--carbon);color:var(--crema);text-align:center;font-size:13px;padding:8px 12px;padding-top:calc(8px + env(safe-area-inset-top,0px));letter-spacing:.04em}
header.bar{position:sticky;top:0;z-index:20;background:var(--material-cabecera);-webkit-backdrop-filter:var(--material-desenfoque);backdrop-filter:var(--material-desenfoque)}
header.bar::after{content:"";position:absolute;left:0;right:0;bottom:-16px;height:16px;background:linear-gradient(rgba(30,26,24,.07),transparent);pointer-events:none}
@media(prefers-reduced-transparency:reduce){header.bar{background:var(--crema);-webkit-backdrop-filter:none;backdrop-filter:none}}
.nav{max-width:1120px;margin:0 auto;padding:0 20px;height:60px;display:flex;align-items:center;justify-content:space-between}
.wm{font:600 22px var(--fuente-display)}
.wm small{font:400 12px var(--fuente-ui);color:var(--carbon-60);margin-left:8px}
.nav nav a{font-size:14px;font-weight:500;text-decoration:none;margin-left:24px}
@media(max-width:640px){.nav nav a:not(:last-child){display:none}}
a{color:inherit}
.btn{display:inline-block;border:0;background:var(--carbon);color:var(--crema);font:700 15px var(--fuente-ui);padding:15px 28px;border-radius:999px;text-decoration:none;cursor:pointer;transition:transform var(--mov-100) var(--curva-deceleracion),background-color var(--mov-150) var(--curva-deceleracion)}
.btn:active{transform:scale(.97)}
.btn.alt{background:transparent;color:var(--carbon);border:2px solid var(--carbon);padding:13px 26px;margin-left:8px}
.weave{background-image:repeating-linear-gradient(45deg,rgba(30,26,24,.07) 0 2px,transparent 2px 12px),repeating-linear-gradient(-45deg,rgba(30,26,24,.07) 0 2px,transparent 2px 12px)}
/* hero */
.hero{background:var(--beige)}
.hero-in{max-width:1120px;margin:0 auto;padding:52px 20px 68px;display:grid;gap:36px;align-items:center}
@media(min-width:820px){.hero-in{grid-template-columns:1.1fr .9fr;min-height:540px}}
.tagline{font-weight:700;font-size:15px;color:var(--terracota-texto);letter-spacing:.02em}
.hero h1{font-size:clamp(38px,8vw,68px);margin:12px 0 20px}
.hero p{color:var(--carbon-60);max-width:46ch;font-size:18px;margin:0 0 28px}
.stage{background:var(--salvia);border-radius:28px;padding:44px 16px 30px;display:flex;flex-direction:column;align-items:center;gap:18px;position:relative;overflow:hidden}
.stage>*{position:relative}
.box{width:min(290px,72vw);height:230px;border:0;background:none;padding:0;cursor:pointer;position:relative;transition:transform var(--mov-100) var(--curva-deceleracion)}
.box:active{transform:scale(.98)}
.base{position:absolute;bottom:0;left:0;right:0;height:145px;background:var(--crema);border-radius:4px 4px 16px 16px;overflow:hidden;box-shadow:0 10px 24px rgba(30,26,24,.18)}
.base::after{content:"";position:absolute;left:50%;top:0;bottom:0;width:22px;margin-left:-11px;background:var(--terracota)}
/* Excepción de carácter documentada (design.md D4): la tapa conserva su
   arco de 0.8s — la delicia del producto — aislada de los tokens de chrome. */
.lid{position:absolute;left:-8px;right:-8px;top:38px;height:54px;background:var(--terracota);border-radius:8px;transform-origin:left bottom;transition:transform .8s cubic-bezier(.25,.8,.3,1);z-index:3;display:grid;place-items:center;color:var(--crema);font:600 19px var(--fuente-display)}
.box.open .lid{transform:translate(-16px,-30px) rotate(-24deg)}
.items{position:absolute;left:12px;right:12px;top:74px;display:flex;gap:8px;z-index:2;opacity:0;transform:translateY(34px);transition:.7s .2s}
.box.open .items{opacity:1;transform:translateY(-8px)}
.it{flex:1;height:68px;background:var(--salvia);color:var(--carbon);border-radius:10px;display:grid;place-items:center;font:600 13px var(--fuente-ui);text-align:center}
.hint{font-size:14px;color:var(--carbon)}
/* bandas */
.bands{display:grid;gap:14px}
@media(min-width:820px){.bands{grid-template-columns:1fr 1fr}}
.band{border-radius:24px;padding:34px 28px;color:var(--carbon);min-height:220px}
.band:nth-child(1){background-color:var(--beige-suave)}.band:nth-child(2){background-color:var(--salvia)}.band:nth-child(3){background-color:var(--taupe)}.band:nth-child(4){background-color:var(--beige)}
.band h3{font-size:30px;margin-bottom:14px}
.band ul{margin:0;padding:0;list-style:none}
.band li{padding:6px 0;border-top:1px solid rgba(30,26,24,.25);font-size:15px}
/* planes */
.toggle{display:inline-flex;background:var(--beige);border-radius:999px;padding:4px;margin-bottom:26px}
.toggle button{border:0;background:none;color:var(--carbon);font:500 14px var(--fuente-ui);padding:10px 20px;border-radius:999px;cursor:pointer;transition:background-color var(--mov-150) var(--curva-deceleracion),color var(--mov-150) var(--curva-deceleracion),transform var(--mov-100) var(--curva-deceleracion)}
.toggle button:active{transform:scale(.97)}
.toggle button[aria-pressed="true"]{background:var(--carbon);color:var(--crema)}
.plans{display:grid;gap:14px}
@media(min-width:820px){.plans{grid-template-columns:repeat(3,1fr)}}
.plan{background:var(--crema);border:2px solid var(--beige-linea);border-radius:24px;padding:30px 26px;text-align:left;color:var(--carbon);cursor:pointer;font:inherit;transition:border-color var(--mov-150) var(--curva-deceleracion),background-color var(--mov-150) var(--curva-deceleracion),transform var(--mov-100) var(--curva-deceleracion)}
.plan:active{transform:scale(.98)}
.plan[aria-pressed="true"]{border-color:var(--terracota);background:var(--beige)}
.plan h3{font-size:28px}
.tag{font-size:12px;font-weight:700;color:var(--terracota-texto);height:18px;display:block}
.price{font:600 34px var(--fuente-display);margin:16px 0 0}
.mu{color:var(--carbon-60);font-size:13px}
.plan ul{list-style:none;padding:0;margin:18px 0;font-size:15px;color:var(--carbon-60)}
.plan li{padding:8px 0;border-top:1px solid var(--beige-linea)}
.give{font-size:13px;font-weight:700;background:var(--beige-suave);color:var(--carbon);border-radius:12px;padding:8px 12px;display:inline-block}
/* pasos */
.steps{list-style:none;padding:0;margin:0;counter-reset:s;display:grid;gap:14px}
@media(min-width:820px){.steps{grid-template-columns:repeat(4,1fr)}}
.steps li{counter-increment:s;background:var(--beige);border-radius:20px;padding:24px 22px}
.steps li:nth-child(2){background:var(--beige-suave)}.steps li:nth-child(3){background:var(--salvia)}.steps li:nth-child(4){background:var(--taupe)}
.steps li{color:var(--carbon)}
.steps li::before{content:counter(s);display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--carbon);color:var(--crema);font:600 16px var(--fuente-display);margin-bottom:18px}
.steps b{display:block;font:500 21px var(--fuente-display);margin-bottom:4px}
.steps span{font-size:15px}
/* calculadora */
.calc{background:var(--beige);border-radius:28px;padding:30px 24px;display:grid;gap:32px}
@media(min-width:820px){.calc{grid-template-columns:1fr 1fr;padding:48px}}
label{display:block;font-size:14px;font-weight:700;margin-bottom:8px}
label span{color:var(--terracota-texto)}
input[type=range]{width:100%;accent-color:var(--terracota);margin-bottom:22px}
select,.f input{width:100%;padding:14px;border:1px solid var(--beige-linea);border-radius:14px;background:var(--crema);color:var(--carbon);font:inherit;margin-bottom:20px}
.big{font:600 clamp(42px,9vw,64px) var(--fuente-display);color:var(--terracota-texto);line-height:1;margin:4px 0 18px}
.stat{display:flex;justify-content:space-between;padding:11px 0;border-top:1px solid var(--beige-linea);font-size:15px;color:var(--carbon-60)}
.stat span:last-child{color:var(--carbon);font-weight:700}
.msg{margin-top:18px;background:var(--crema);border-left:4px solid var(--terracota);border-radius:0 14px 14px 0;padding:14px 16px;font:italic 500 18px/1.35 var(--fuente-display)}
.note{font-size:13px;color:var(--carbon-60)}
/* causas */
.causes{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.cause{border-radius:20px;padding:26px 22px;color:var(--carbon);min-height:130px}
.cause:nth-child(1){background:var(--beige-suave)}.cause:nth-child(2){background:var(--salvia)}.cause:nth-child(3){background:var(--taupe)}.cause:nth-child(4){background:var(--beige)}.cause:nth-child(5){background:var(--beige-suave)}.cause:nth-child(6){background:var(--salvia)}
.cause b{font:500 22px var(--fuente-display);display:block;margin-bottom:4px}
.cause span{font-size:14px}
.story{margin-top:14px;border:2px dashed var(--terracota);border-radius:20px;padding:24px}
.story b{font:500 22px var(--fuente-display)}
/* tabla */
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:520px}
td,th{padding:14px 0;text-align:left;border-bottom:1px solid var(--beige-linea);vertical-align:top;font-size:15px}
th{width:130px;font:500 20px var(--fuente-display);white-space:nowrap}
td{color:var(--carbon-60)}
/* preventa */
.pre{background:var(--terracota);color:var(--carbon);border-radius:28px;padding:34px 24px;display:grid;gap:30px}
@media(min-width:820px){.pre{grid-template-columns:1fr 1fr;padding:52px}}
.pre p{max-width:40ch}
.pre .f input,.pre select{background:var(--crema);color:var(--carbon);border-color:transparent;margin-bottom:12px}
.pre .btn{background:var(--carbon);color:var(--crema)}
.track{height:8px;background:rgba(30,26,24,.25);border-radius:99px;margin:16px 0 8px;overflow:hidden}
.track i{display:block;height:100%;background:var(--carbon);width:0;transition:width var(--mov-400) var(--curva-deceleracion)}
.ok{background:var(--crema);padding:14px;border-radius:12px;display:none;margin-top:14px}
/* carrito de la caja, independiente del de productos (src/scripts/carrito.js via Layout) */
.cbtncarrito{position:relative;flex:none;width:40px;height:40px;margin-left:16px;border:0;border-radius:50%;background:transparent;color:var(--carbon);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:background-color var(--mov-150) var(--curva-deceleracion)}
.cbtncarrito svg{width:21px;height:21px}
.cbtncarrito:focus-visible{outline:2px solid var(--terracota);outline-offset:2px}
@media(hover:hover){.cbtncarrito:hover{background:rgba(30,26,24,.06)}}
.cbadge{position:absolute;top:2px;right:0;min-width:17px;height:17px;padding-inline:4px;border-radius:var(--radius-pill);background:var(--terracota);color:var(--crema);font:700 10px var(--fuente-ui);display:flex;align-items:center;justify-content:center}
footer{background:var(--carbon);color:var(--crema);padding:44px 20px 64px;text-align:center;font-size:14px}
footer .wm{margin-bottom:6px}
footer .n{opacity:.7}
</style>

<script is:inline>
var P=[
 {n:'Esencial',p:49900,a:5000,l:['1 producto CreativeLab','Tarjeta de impacto']},
 {n:'Plus',p:79900,a:8000,l:['1 producto principal','1 detalle adicional','Empaque especial'],t:'La más elegida'},
 {n:'Premium',p:119900,a:12000,l:['2 a 3 productos','Edición especial','Personalización']}
];
var sel=1,freq='Semestral';
function money(x){return '$'+Math.round(x).toLocaleString('es-CO')}
function drawPlans(){
  var h='';
  P.forEach(function(x,i){
    h+='<button class="plan" data-i="'+i+'" aria-pressed="'+(i==sel)+'"><span class="tag">'+(x.t||'')+'</span><h3>'+x.n+'</h3><div class="price">'+money(x.p)+'</div><div class="mu">por caja</div><ul>'+
    x.l.map(function(t){return '<li>'+t+'</li>'}).join('')+'</ul><span class="give">Aporte social: '+money(x.a)+' por caja</span></button>';
  });
  document.getElementById('plans').innerHTML=h;
  var s=P[sel],k=freq=='Semestral'?6:12;
  document.getElementById('sel').textContent='Suscripción '+freq.toLowerCase()+' '+s.n+': '+k+' cajas, una cada mes. Total del periodo '+money(s.p*k)+', con '+money(s.a*k)+' para el aliado social.';
  document.getElementById('pp').value=s.n;
}
document.getElementById('plans').addEventListener('click',function(e){var b=e.target.closest('.plan');if(!b)return;sel=+b.dataset.i;drawPlans();document.getElementById('cp').value=sel;calc()});
document.querySelectorAll('.toggle button').forEach(function(b){b.onclick=function(){freq=b.dataset.f;document.querySelectorAll('.toggle button').forEach(function(x){x.setAttribute('aria-pressed',x===b)});drawPlans()}});
var box=document.getElementById('box');
box.onclick=function(){var o=box.classList.toggle('open');box.setAttribute('aria-pressed',o);document.getElementById('hint').textContent=o?'Producto, detalle y tarjeta de historia':'Toca la caja para abrirla'};
function calc(){
  var n=+document.getElementById('n').value,pl=P[+document.getElementById('cp').value],m=document.getElementById('cm').value;
  var per=m=='fijo'?pl.a:pl.p*0.10;
  document.getElementById('nv').textContent=n;
  document.getElementById('tot').textContent=money(per*n);
  document.getElementById('rev').textContent=money(pl.p*n);
  document.getElementById('per').textContent=money(per);
  document.getElementById('pc').textContent=(per/pl.p*100).toFixed(1).replace('.',',')+'%';
  document.getElementById('msg').textContent='“Este mes, gracias a '+n+' suscripciones, destinamos '+money(per*n)+' a nuestro aliado social.”';
}
['n','cp','cm'].forEach(function(id){document.getElementById(id).addEventListener('input',calc)});
var res=12;
function bar(){document.getElementById('bar').style.width=(res/30*100)+'%';document.getElementById('cnt').textContent=res+' de 30 cajas reservadas'}
document.getElementById('go').onclick=function(){
  var nm=document.getElementById('nm').value.trim(),ct=document.getElementById('ct').value.trim(),er=document.getElementById('er'),ok=document.getElementById('ok');
  er.textContent='';
  if(!nm||!ct){er.textContent='Escribe tu nombre y un WhatsApp o correo para reservar.';return}
  if(res>=30){er.textContent='Las 30 cajas piloto ya están reservadas.';return}
  res++;bar();ok.style.display='block';ok.textContent='Listo, '+nm+'. Reservaste la caja '+document.getElementById('pp').value+'. Te escribiremos a '+ct+'.';
};
/* Suscripción elegida → carrito de la caja (independiente del carrito de
   productos; window.Carrito.caja lo provee src/scripts/carrito.js, cargado
   por Layout como módulo: al hacer click ya está disponible). El precio del
   item es el total del periodo. duracion habilita la regla de un plan por
   Semestral/Anual: elegir otro plan de la misma duración reemplaza al que
   estaba. */
document.getElementById('suscribir').onclick=function(){
  if(!window.Carrito||!window.Carrito.caja)return;
  var s=P[sel],k=freq=='Semestral'?6:12;
  window.Carrito.caja.agregar({
    id:'suscripcion|'+s.n+'|'+freq,
    tipo:'suscripcion',
    nombre:'Caja '+s.n+' · '+freq,
    descripcion:k+' cajas, una cada mes · Aporte social '+money(s.a)+' por caja',
    precio:s.p*k,
    cantidad:1,
    duracion:freq
  });
  window.Carrito.caja.abrir();
};
drawPlans();document.getElementById('cp').value=sel;calc();setTimeout(bar,300);
</script>