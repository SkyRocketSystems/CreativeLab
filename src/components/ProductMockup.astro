---
interface Props {
  product?: 'tote' | 'organizador' | 'decorativo';
  color?: string;
  material?: 'lona' | 'lienzo' | 'impermeable' | 'premium';
  stateful?: boolean;
  etiqueta?: string;
  /* Foto real del tote bag (public/Totebags). Solo el tote tiene
     fotografías: fija la imagen en instancias estáticas; el configurador
     la controla reactivamente en las instancias stateful vía data-foto. */
  foto?: 'beige' | 'green' | 'personalizado' | null;
  /* 'final' marca el mockup del Resumen: con tote muestra la foto
     personalizada en lugar de la del color elegido. */
  modo?: 'final' | null;
}

const {
  product = 'tote',
  color = '#E6DEC9',
  material = 'lona',
  stateful = false,
  etiqueta = 'Vista previa del producto',
  foto = null,
  modo = null,
} = Astro.props;
---

<div
  class:list={['mockup', { stateful }]}
  data-product={product}
  data-material={material}
  data-pocket="off"
  data-label="off"
  data-foto={foto ?? undefined}
  data-modo={modo ?? undefined}
  style={`--fabric:${color}`}
  role="img"
  aria-label={etiqueta}
