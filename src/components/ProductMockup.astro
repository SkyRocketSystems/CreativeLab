          fill="none"
          stroke="var(--stitch)"
          stroke-width="1.8"
          stroke-dasharray="6 5"></rect>
        <path d="M116 296 q44 20 88 8" stroke="rgba(30,26,24,.08)" stroke-width="2" fill="none"></path>
        <g class="p-pocket">
          <rect
            x="210"
            y="240"
            width="86"
            height="66"
            rx="12"
            fill="var(--fabric-pocket)"
            stroke="rgba(30,26,24,.20)"
            stroke-width="1.5"></rect>
          <rect
            x="218"
            y="250"
            width="70"
            height="46"
            rx="8"
            fill="none"
            stroke="var(--stitch)"
            stroke-width="1.6"
            stroke-dasharray="5 4"></rect>
        </g>
        <g class="p-etiqueta" transform="rotate(-10 270 108)">
          <rect
            x="248"
            y="94"
            width="56"
            height="28"
            rx="7"
            fill="#FAF8F3"
            stroke="rgba(30,26,24,.28)"
            stroke-width="1.4"></rect>
          <rect x="256" y="102" width="22" height="4" rx="2" fill="#AD8470"></rect>
          <rect x="256" y="110" width="32" height="3" rx="1.5" fill="rgba(30,26,24,.25)"></rect>
        </g>
      </g>
    </svg>
    <div class="mockup-phrase" aria-hidden="true"></div>
  </div>
</div>

<style>
  .mockup {
    --fabric: #e6dec9;
    --fabric-dark: color-mix(in srgb, var(--fabric) 84%, #1e1a18);
    --fabric-darker: color-mix(in srgb, var(--fabric) 68%, #1e1a18);
    --fabric-pocket: color-mix(in srgb, var(--fabric) 90%, #1e1a18);
    --stitch: rgba(30, 26, 24, 0.38);
    position: relative;
    filter: drop-shadow(0 10px 14px rgba(30, 26, 24, 0.1));
  }

  .mockup-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 400 / 440;
    container-type: inline-size;
  }

  .mockup-stage > svg {
    width: 100%;
    height: 100%;
  }

  /* Visibilidad por producto */
  .p-tote,
  .p-organizador,
  .p-decorativo {
    display: none;
  }

  .mockup[data-product='tote'] .p-tote,
  .mockup[data-product='organizador'] .p-organizador,
  .mockup[data-product='decorativo'] .p-decorativo {
    display: block;
  }

  /* Bolsillo y etiqueta */
  .p-pocket,
  .p-etiqueta {
    display: none;
  }

  .mockup[data-pocket='on'] .p-pocket,
  .mockup[data-label='on'] .p-etiqueta {
    display: block;
  }

  /* Texturas por material */
  .tex {
    fill: url(#tex-lona);
  }

  .mockup[data-material='lienzo'] .tex {
    fill: url(#tex-lienzo);
  }

  .mockup[data-material='impermeable'] .tex {
    fill: url(#tex-impermeable);
  }

  .mockup[data-material='premium'] .tex {
    fill: url(#tex-premium);
  }

  /* Tipografía y color de la frase */
  .mockup[data-fuente='moderna'] {
    --fuente-frase: var(--fuente-ui);
  }

  .mockup[data-fuente='manuscrita'] {
    --fuente-frase: var(--fuente-manuscrita);
  }

  .mockup[data-fuente='clasica'] {
    --fuente-frase: var(--fuente-clasica);
  }

  .mockup[data-colortexto='carbon'] {
    --color-frase: #1e1a18;
  }

  .mockup[data-colortexto='crema'] {
    --color-frase: #faf8f3;
  }

  .mockup[data-colortexto='terracota'] {
    --color-frase: #c86b45;
  }

  /* Frase estampada */
  .mockup-phrase {
    position: absolute;
    display: none;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--fuente-frase, var(--fuente-ui));
    font-weight: 600;
    color: var(--color-frase, #1e1a18);
    font-size: clamp(14px, 6.5cqw, 34px);
    line-height: 1.18;
    word-break: break-word;
    pointer-events: none;
  }

  .mockup.stateful .mockup-phrase:not(:empty) {
    display: flex;
  }

  .mockup[data-fuente='manuscrita'] .mockup-phrase {
    font-size: clamp(16px, 8cqw, 40px);
  }

  /* Zonas de la frase — TOTE */
  .mockup[data-product='tote'][data-pos='centro'] .mockup-phrase {
    inset: 36% 20% 34% 20%;
  }

  .mockup[data-product='tote'][data-pos='inferior'] .mockup-phrase {
    inset: 54% 24% 28% 24%;
  }

  .mockup[data-product='tote'][data-pos='esquina'] .mockup-phrase {
    inset: 58% 46% 20% 12%;
    justify-content: flex-start;
    text-align: left;
    font-size: clamp(12px, 5cqw, 24px);
  }

  /* Zonas — ORGANIZADOR */
  .mockup[data-product='organizador'][data-pos='centro'] .mockup-phrase {
    inset: 46% 20% 30% 20%;
  }

  .mockup[data-product='organizador'][data-pos='inferior'] .mockup-phrase {
    inset: 60% 24% 22% 24%;
  }

  .mockup[data-product='organizador'][data-pos='esquina'] .mockup-phrase {
    inset: 56% 44% 20% 10%;
    justify-content: flex-start;
    text-align: left;
    font-size: clamp(12px, 5cqw, 24px);
  }

  /* Zonas — DECORATIVO */
  .mockup[data-product='decorativo'][data-pos='centro'] .mockup-phrase {
    inset: 38% 18% 40% 18%;
  }

  .mockup[data-product='decorativo'][data-pos='inferior'] .mockup-phrase {
    inset: 50% 22% 34% 22%;
  }

  .mockup[data-product='decorativo'][data-pos='esquina'] .mockup-phrase {
    inset: 30% 44% 46% 16%;
    justify-content: flex-start;
    text-align: left;
    font-size: clamp(12px, 5.5cqw, 26px);
  }
</style>


