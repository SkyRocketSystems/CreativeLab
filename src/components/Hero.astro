---
import ProductMockup from './ProductMockup.astro';
import TarjetaRegalo from './TarjetaRegalo.astro';
import Configurator from './Configurator.astro';

const beneficios = [
  {
    texto: 'Personalización a tu medida',
    icono: 'M4 20l1-4L16 5l3 3L8 19l-4 1Z',
  },
  {
    texto: 'Vista previa en tiempo real',
    icono: 'M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z',
  },
  {
    texto: 'Diseño funcional con propósito',
    icono: 'M12 20s-7-4.3-7-9a4 4 0 0 1 7-2.5A4 4 0 0 1 19 11c0 4.7-7 9-7 9Z',
  },
];
---

<section class="seccion-hero" id="crear" aria-label="Crea el tuyo">
  <div class="hero-canvas">
    <div class="hero-bento">
      <!-- A · Bloque de marca y conversión -->
      <div class="bloque bloque-marca">
        <span class="eyebrow-chip">Productos funcionales con impacto social</span>
        <h1>Diseña algo que sea realmente tuyo</h1>
        <p class="marca-texto">
          Personaliza tote bags, organizadores y objetos decorativos con color, materiales y
          mensajes que hablan de ti.
        </p>
        <a class="btn btn-primario marca-cta" href="#panel-configurador">Empezar a crear →</a>
        <ul class="beneficios">
          {
            beneficios.map((b) => (
              <li>
                <span class="beneficio-icono" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d={b.icono} />
                  </svg>
                </span>
                {b.texto}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- B + C · Preview dominante + panel flotante del configurador -->
      <div class="bloque preview-wrap">
        <!-- Barra del modo inmersivo (body.personalizando): título, total en
             vivo y salida. Oculta en el bento normal. -->
        <div class="inmersivo-barra">
          <p class="inmersivo-titulo">Personalizando tu diseño</p>
          <span class="inmersivo-precio" id="precio-inmersivo" aria-live="polite"></span>
          <button class="btn btn-primario inmersivo-terminar" id="btn-terminar" type="button">✓ Terminar</button>
        </div>
        <div class="preview-tarjeta">
          <div class="preview-overlay">
            <p class="preview-titulo">Tu diseño. Nuestro propósito.</p>
            <p class="preview-texto">Convierte una idea en un objeto único.</p>
            <button class="preview-ampliar" id="btn-ampliar" type="button" aria-label="Ampliar vista del diseño">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path>
              </svg>
            </button>
          </div>
          <div class="preview-producto" data-vista="producto">
            <ProductMockup stateful={true} product="tote" color="#E6DEC9" etiqueta="Vista previa en tiempo real de tu diseño" />
            <!-- Con el tab de texto activo, la tarjeta de regalo ocupa el
                 lugar del producto (solo dentro del editor inmersivo) -->
            <TarjetaRegalo stateful={true} />
          </div>
        </div>
        <Configurator />
      </div>

      <!-- D · Bloque derecho superior: valor de marca -->
      <div class="bloque bloque-valor">
        <div class="bloque-cabecera">
          <p class="valor-eyebrow">Diseño con propósito</p>
          <span class="flecha-circulo" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15">
              <path d="M7 17 17 7M8 7h9v9"></path>
            </svg>
          </span>
        </div>
        <p class="valor-sub">Crea. Personaliza. Comparte.</p>
        <p class="valor-grande">100% tuyo</p>
        <p class="valor-texto">Cada elección transforma un objeto cotidiano en algo único.</p>
        <div class="valor-decor" aria-hidden="true">
          <ProductMockup product="tote" color="#AD8470" material="lienzo" etiqueta="" />
        </div>
      </div>

      <!-- E · Bloque derecho central: diseños recientes -->
      <div class="bloque bloque-recientes">
        <div class="bloque-cabecera">
          <h3>Diseños recientes</h3>
          <span class="flecha-circulo" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15">
              <path d="M7 17 17 7M8 7h9v9"></path>
            </svg>
          </span>
        </div>
        <div class="presets">
          <button class="preset" data-preset="toteNatural" data-nombre="Tote Natural" type="button">
            <span class="preset-thumb"><ProductMockup product="tote" color="#E6DEC9" etiqueta="" foto="beige" /></span>
            <span class="preset-nombre">Tote Natural</span>
            <span class="preset-estado">Editado hoy</span>
          </button>
          <button class="preset" data-preset="organizadorTerracota" data-nombre="Organizador Terracota" type="button">
            <span class="preset-thumb"><ProductMockup product="organizador" color="#C86B45" etiqueta="" /></span>
            <span class="preset-nombre">Organizador Terracota</span>
            <span class="preset-estado">Guardado ayer</span>
          </button>
          <button class="preset" data-preset="decorativoSalvia" data-nombre="Decorativo Salvia" type="button">
            <span class="preset-thumb"><ProductMockup product="decorativo" color="#B8D3AE" material="premium" etiqueta="" /></span>
            <span class="preset-nombre">Decorativo Salvia</span>
            <span class="preset-estado">Editado hace 3 días</span>
          </button>
        </div>
      </div>

      <!-- F · Bloque derecho inferior: resumen y precio -->
      <div class="bloque bloque-resumen">
        <div class="bloque-cabecera">
          <h3>Resumen de tu diseño</h3>
          <span class="flecha-circulo" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="15" height="15">
              <path d="M7 17 17 7M8 7h9v9"></path>
            </svg>
          </span>
        </div>
        <p class="progreso-indicador"><span id="progreso-contador">3 de 5</span> detalles listos</p>
        <p class="progreso-ayuda">Completa producto, color, material, tarjeta y extras.</p>
        <div
          class="barra"
          id="barra-progreso-fondo"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="5"
          aria-valuenow="3"
          aria-label="Progreso de personalización"
        >
          <div class="barra-relleno" id="barra-progreso" style="width:60%"></div>
        </div>
        <div class="precio-bloque">
          <span class="precio-etiqueta">Total estimado</span>
          <span class="precio-valor" id="precio-hero">$40.000 COP</span>
          <span class="precio-nota">El valor se actualiza mientras personalizas</span>
        </div>
        <a class="btn btn-borde btn-sm" href="#resumen">Ver detalle</a>
      </div>
    </div>
  </div>
</section>

<style>
  .seccion-hero {
    background: var(--crema);
    padding-top: 24px;
    padding-bottom: 40px;
  }

  @media (min-width: 1080px) {
    .seccion-hero {
      padding-top: 48px;
      padding-bottom: 64px;
    }
  }

  .hero-canvas {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  @media (min-width: 1080px) {
    .hero-canvas {
      padding-inline: 32px;
    }
  }

  .hero-bento {
    background: var(--crema);
    border-radius: var(--radius-contenedor);
    padding: 20px;
    box-shadow: var(--sombra-media);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 1080px) {
    .hero-bento {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: repeat(8, minmax(0, 1fr));
      gap: 24px;
      min-height: 760px;
      padding: 40px;
    }
  }

  /* ---------- A · Bloque de marca ---------- */
  .bloque-marca {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    order: 1;
  }

  .eyebrow-chip {
    display: inline-flex;
    align-items: center;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: var(--beige);
    color: var(--carbon);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .marca-texto {
    font-size: 16px;
    color: rgba(30, 26, 24, 0.75);
    max-width: 40ch;
  }

  .beneficios {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 4px;
  }

  .beneficios li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    color: rgba(30, 26, 24, 0.8);
  }

  .beneficio-icono {
    width: 34px;
    height: 34px;
    min-width: 34px;
    border-radius: 50%;
    background: var(--beige);
    color: var(--carbon);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .beneficio-icono svg {
    width: 16px;
    height: 16px;
  }

  /* ---------- B + C · Preview + configurador ---------- */
  .preview-wrap {
    order: 2;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .preview-tarjeta {
    position: relative;
    background: linear-gradient(160deg, #f0eadb 0%, var(--beige) 100%);
    border-radius: var(--radius-contenedor);
    overflow: hidden;
    min-height: 440px;
    display: flex;
    align-items: center;
    justify-content: center;
    /* El preview invita a tocarlo: despliega el editor inmersivo */
    cursor: pointer;
  }

  .preview-overlay {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    max-width: 60%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    text-align: right;
  }

  @media (min-width: 1080px) {
    .preview-overlay {
      max-width: 35%;
      top: 24px;
      right: 24px;
    }
  }

  .preview-titulo {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.25;
  }

  .preview-texto {
    font-size: 13px;
    color: rgba(30, 26, 24, 0.68);
    line-height: 1.4;
  }

  .preview-ampliar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--crema);
    border: 1px solid var(--beige-linea);
    color: var(--carbon);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--sombra-tarjeta);
    transition: transform var(--mov-100) var(--curva-deceleracion),
      background-color var(--mov-150) var(--curva-deceleracion);
  }

  @media (hover: hover) {
    .preview-ampliar:hover {
      background: var(--beige);
    }
  }

  .preview-ampliar:active {
    transform: scale(0.94);
  }

  .preview-ampliar svg {
    width: 17px;
    height: 17px;
  }

  .preview-producto {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 64px 24px 24px;
  }

  .preview-producto :global(.mockup) {
    width: min(70%, 320px);
  }

  /* Con el tab de texto activo dentro del editor, la tarjeta de regalo
     ocupa el lugar del producto LLENANDO el área: columna flexible cuyo
     cuerpo crece y la zona del mensaje absorbe el alto sobrante (como una
     tarjeta de verdad). Solo dentro del editor; el bento muestra el
     producto. */
  .preview-producto :global(.tarjeta-regalo) {
    display: none;
  }

  :global(body.personalizando) .preview-producto[data-vista='tarjeta'] :global(.tarjeta-regalo) {
    display: flex;
    flex-direction: column;
    width: min(88%, 440px);
    max-width: min(88%, 440px);
    height: 100%;
    max-height: 100%;
    animation: asomar-tarjeta var(--mov-300) var(--curva-deceleracion) both;
  }

  :global(body.personalizando) .preview-producto[data-vista='tarjeta'] :global(.tr-cuerpo) {
    flex: 1;
  }

  :global(body.personalizando) .preview-producto[data-vista='tarjeta'] :global(.tr-mensaje) {
    flex: 1;
  }

  :global(body.personalizando) .preview-producto[data-vista='tarjeta'] :global(.mockup) {
    display: none;
  }

  @keyframes asomar-tarjeta {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* El panel de opciones vive oculto en el bento: solo se muestra dentro
     del editor inmersivo (ver bloque del modo inmersivo abajo). */
  .preview-wrap :global(.panel-configuracion) {
    display: none;
  }

  @media (min-width: 1080px) {
    .preview-wrap {
      position: relative;
      display: block;
    }

    .preview-tarjeta {
      height: 100%;
      min-height: 0;
    }

    .preview-producto {
      position: absolute;
      inset: 0;
      z-index: 1;
      padding: 64px 48px;
    }

    .preview-producto :global(.mockup) {
      width: min(72%, 400px);
      max-height: 100%;
    }
  }

  /* ---------- Modo inmersivo de personalización ----------
     Lo activa configurator.js con body.personalizando al elegir la primera
     opción: el preview se despliega (clip-path animado) desde su posición
     en el bento hasta ocupar el viewport, con el panel de opciones a lo
     ancho. El overlay es opaco: el resto informativo queda detrás; solo se
     retiran las capas flotantes que quedarían encima. */
  .inmersivo-barra {
    display: none;
  }

  :global(body.personalizando) {
    overflow: hidden;
  }

  :global(body.personalizando #cabecera),
  :global(body.personalizando #barra-movil),
  :global(body.personalizando #promo-caja) {
    display: none;
  }

  :global(body.personalizando) .preview-wrap {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: max(16px, env(safe-area-inset-top)) 16px
      max(16px, env(safe-area-inset-bottom));
    background: var(--crema);
    overflow: auto;
    overscroll-behavior: contain;
    animation: desplegar-inmersivo var(--mov-400) var(--curva-deceleracion)
      both;
  }

  :global(body.personalizando) .inmersivo-barra {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .inmersivo-titulo {
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
  }

  .inmersivo-precio {
    margin-left: auto;
    font-size: 14px;
    font-weight: 700;
    color: var(--terracota);
    white-space: nowrap;
  }

  .inmersivo-barra .btn {
    padding: 8px 18px;
    min-height: 40px;
    white-space: nowrap;
  }

  /* Preview a todo el alto disponible; el panel pasa de flotante a estático
     y ocupa todo el ancho (sus container queries re-miden solos). */
  :global(body.personalizando) .preview-tarjeta {
    flex: 1;
    min-height: min(52vh, 680px);
  }

  :global(body.personalizando) .preview-producto {
    position: static;
    inset: auto;
    height: 100%;
    padding: 64px 24px 24px;
  }

  :global(body.personalizando) .preview-producto :global(.mockup) {
    width: min(70%, 440px);
    max-height: 100%;
  }

  :global(body.personalizando) .preview-wrap :global(.panel-configuracion) {
    display: block;
    position: static;
    z-index: auto;
    width: 100%;
  }

  /* Despliegue desde donde se ve el producto: configurator.js mide el rect
     de la tarjeta y lo deja en --desde-*; la salida (es-saliendo) reproduce
     la trayectoria inversa antes de devolver el bento a su estado. */
  @keyframes desplegar-inmersivo {
    from {
      clip-path: inset(
        var(--desde-arr) var(--desde-der) var(--desde-abj) var(--desde-izq)
          round var(--radius-contenedor)
      );
    }
    to {
      clip-path: inset(0 round 0);
    }
  }

  :global(body.personalizando) .preview-wrap.es-saliendo {
    animation: plegar-inmersivo var(--mov-400) var(--curva-aceleracion) both;
  }

  @keyframes plegar-inmersivo {
    from {
      clip-path: inset(0 round 0);
    }
    to {
      clip-path: inset(
        var(--desde-arr) var(--desde-der) var(--desde-abj) var(--desde-izq)
          round var(--radius-contenedor)
      );
    }
  }

  /* ---------- D · Valor de marca ---------- */
  .bloque-valor {
    position: relative;
    order: 5;
    background: var(--beige-suave);
    border-radius: var(--radius-tarjeta);
    padding: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .bloque-cabecera {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .bloque-cabecera h3 {
    font-size: 16px;
    font-weight: 700;
  }

  .valor-eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--taupe);
  }

  .valor-sub {
    font-size: 13px;
    font-weight: 600;
    color: rgba(30, 26, 24, 0.6);
  }

  .valor-grande {
    font-size: clamp(30px, 4vw, 38px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--terracota);
  }

  .valor-texto {
    font-size: 13.5px;
    color: rgba(30, 26, 24, 0.7);
    max-width: 26ch;
  }

  .valor-decor {
    position: absolute;
    right: -14%;
    bottom: -12%;
    width: 52%;
    opacity: 0.95;
    transform: rotate(10deg);
    pointer-events: none;
  }

  /* ---------- E · Diseños recientes ---------- */
  .bloque-recientes {
    order: 4;
    background: var(--crema);
    border: 1px solid var(--beige-linea);
    border-radius: var(--radius-tarjeta);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .presets {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 4px;
  }

  .preset {
    flex: 1 0 30%;
    min-width: 110px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px;
    border-radius: 16px;
    background: var(--beige-suave);
    border: 1.5px solid transparent;
    text-align: left;
    transition: border-color var(--mov-150) var(--curva-deceleracion),
      transform var(--mov-150) var(--curva-deceleracion),
      box-shadow var(--mov-150) var(--curva-deceleracion);
  }

  @media (hover: hover) {
    .preset:hover {
      border-color: var(--terracota);
      box-shadow: var(--sombra-tarjeta);
    }
  }

  .preset:active {
    transform: translateY(0) scale(0.98);
  }

  .preset-thumb {
    border-radius: 10px;
    overflow: hidden;
    background: var(--crema);
  }

  .preset-nombre {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
  }

  .preset-estado {
    font-size: 11.5px;
    color: rgba(30, 26, 24, 0.55);
  }

  /* ---------- F · Resumen y precio ---------- */
  .bloque-resumen {
    order: 3;
    background: var(--crema);
    border: 1px solid var(--beige-linea);
    border-radius: var(--radius-tarjeta);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-content: space-between;
  }

  .progreso-indicador {
    font-size: 14px;
    font-weight: 600;
  }

  .progreso-indicador span {
    color: var(--terracota);
    font-weight: 800;
  }

  .progreso-ayuda {
    font-size: 12.5px;
    color: rgba(30, 26, 24, 0.55);
  }

  .barra {
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--beige);
    overflow: hidden;
    margin-block: 4px;
  }

  .barra-relleno {
    height: 100%;
    border-radius: var(--radius-pill);
    background: var(--terracota);
    transition: width var(--mov-300) var(--curva-deceleracion);
  }

  .precio-bloque {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block: 6px;
  }

  .precio-etiqueta {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(30, 26, 24, 0.55);
  }

  .precio-valor {
    font-size: clamp(32px, 3vw, 40px);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--terracota);
    line-height: 1.1;
  }

  .precio-nota {
    font-size: 12px;
    color: rgba(30, 26, 24, 0.55);
  }

  .bloque-resumen .btn {
    align-self: flex-start;
    margin-top: 6px;
  }

  /* ---------- Mini catálogo ---------- */
  .mini-catalogo {
    order: 6;
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--beige);
    border-radius: var(--radius-tarjeta);
    padding: 14px;
    max-width: 300px;
  }

  .mini-imagen {
    width: 84px;
    min-width: 84px;
    border-radius: 14px;
    overflow: hidden;
    background: var(--crema);
  }

  .mini-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .mini-titulo {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.2;
  }

  .mini-texto {
