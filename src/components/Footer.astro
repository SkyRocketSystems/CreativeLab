---
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor pie-grid">
    <div class="pie-marca">
      <a class="pie-logo" href="#crear" aria-label="CreativeLab — ir al inicio">
        <svg class="pie-logo-marca" viewBox="0 0 40 40" aria-hidden="true">
          <rect width="40" height="40" rx="12" fill="#FAF8F3"></rect>
          <circle cx="17" cy="20" r="5.5" fill="#C86B45"></circle>
          <rect x="24.5" y="14.5" width="5" height="11" rx="2.5" fill="#B8D3AE"></rect>
        </svg>
        <span>Creative<span class="pie-logo-acento">Lab</span></span>
      </a>
      <p class="pie-frase">Diseñado por ti, hecho con propósito</p>
      <div class="pie-redes">
        <a href="#crear" id="enlace-instagram" aria-label="Instagram de CreativeLab">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
        <button data-accion="whatsapp" type="button" aria-label="Escríbenos por WhatsApp">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 0 1 12 4Zm-3 4.4c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.2.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.1.7.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2-.1-.1-.2-.2-.5-.3l-1.7-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.1-.2 0-.4.1-.5l.6-.7c.1-.2.2-.3.3-.5v-.5L10 8.7c-.2-.4-.4-.3-.6-.3h-.4Z"></path>
          </svg>
        </button>
        <a href="mailto:hola@creativelab.co" aria-label="Correo de CreativeLab">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5.5" width="18" height="13" rx="3"></rect>
            <path d="m3.5 7.5 8.5 6 8.5-6"></path>
          </svg>
        </a>
      </div>
    </div>

    <nav class="pie-nav" aria-label="Enlaces del pie de página">
      <span class="pie-nav-titulo">Explora</span>
      <ul>
        <li><a href="#ferias">Ferias</a></li>
        <li><a href="#crear">Crear</a></li>
        <li><a href="#resumen">Tu diseño</a></li>
        <li><a href="#como-funciona">Cómo funciona</a></li>
        <li><a href="#catalogo">Catálogo</a></li>
        <li><a href="#impacto">Impacto</a></li>
        <li><a href="#empresas">Empresas</a></li>
      </ul>
    </nav>

    <div class="pie-legal">
      <p>© {anio} CreativeLab. Todos los derechos reservados.</p>
      <p>El precio final de cada producto se confirma antes de la elaboración.</p>
    </div>
  </div>
</footer>

<style>
  .pie {
    background: var(--carbon);
    color: var(--beige);
    padding-block: 48px 32px;
    margin-top: auto;
  }

  .pie-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .pie-grid {
      grid-template-columns: 1.4fr 1fr 1.2fr;
      gap: 40px;
    }
  }

  .pie-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--crema);
    font-size: 20px;
    font-weight: 800;
  }

  .pie-logo-marca {
    width: 30px;
    height: 30px;
  }

  .pie-logo-acento {
    color: var(--terracota);
  }

  .pie-frase {
    margin-top: 12px;
    font-size: 14.5px;
    color: var(--beige);
  }

  .pie-redes {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }

  .pie-redes a,
  .pie-redes button {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(230, 222, 201, 0.35);
    color: var(--beige);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--mov-150) var(--curva-deceleracion),
      border-color var(--mov-150) var(--curva-deceleracion);
  }

  @media (hover: hover) {
    .pie-redes a:hover,
    .pie-redes button:hover {
      background: rgba(230, 222, 201, 0.14);
      border-color: var(--beige);
    }
  }

  .pie-redes svg {
    width: 19px;
    height: 19px;
  }

  .pie-nav-titulo {
    display: block;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(230, 222, 201, 0.6);
    margin-bottom: 14px;
  }

  .pie-nav ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
  }

  .pie-nav a {
    font-size: 14.5px;
    color: var(--beige);
    min-height: 24px;
  }

  @media (hover: hover) {
    .pie-nav a:hover {
      text-decoration: underline;
    }
  }

  .pie-legal {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 12.5px;
    color: rgba(230, 222, 201, 0.65);
    align-self: end;
  }

  @media (max-width: 767px) {
    .pie-legal {
      align-self: flex-start;
    }
  }
</style>

