</div>

<style>
  .mockup {
    --fabric: #e6dec9;
    --fabric-dark: color-mix(in srgb, var(--fabric) 84%, #1e1a18);
    --fabric-darker: color-mix(in srgb, var(--fabric) 68%, #1e1a18);
    --fabric-pocket: color-mix(in srgb, var(--fabric) 90%, #1e1a18);
    --stitch: rgba(30, 26, 24, 0.38);
    position: relative;
    filter: drop-shadow(0 10px 14px rgba(30, 26, 24, 0.1));
  }

  .mockup-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 400 / 440;
    container-type: inline-size;
  }

  .mockup-stage > svg {
    width: 100%;
    height: 100%;
    transition: opacity var(--mov-150) var(--curva-deceleracion);
  }

  /* ---- Fotos reales del tote bag (public/Totebags) ----
     Se activan con data-foto="beige|green|personalizado" y hacen
     crossfade con el dibujo SVG y entre sí. */
  .mockup-fotos {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .mockup-fotos .foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity var(--mov-150) var(--curva-deceleracion);
  }

  .mockup[data-foto='beige'] .foto-beige,
  .mockup[data-foto='green'] .foto-green,
  .mockup[data-foto='personalizado'] .foto-personalizado {
    opacity: 1;
  }

  /* Con foto activa el dibujo SVG se desvanece, la caja se vuelve
     cuadrada (las fotos son 1:1) y la sombra del filtro no aplica. */
  .mockup[data-foto] svg {
    opacity: 0;
  }

  .mockup[data-foto] {
    filter: none;
  }

  .mockup[data-foto] .mockup-stage {
    aspect-ratio: 1 / 1;
  }

  /* Visibilidad por producto */
  .p-tote,
  .p-organizador,
  .p-decorativo {
    display: none;
  }

  .mockup[data-product='tote'] .p-tote,
  .mockup[data-product='organizador'] .p-organizador,
  .mockup[data-product='decorativo'] .p-decorativo {
    display: block;
  }

  /* Bolsillo y etiqueta */
  .p-pocket,
  .p-etiqueta {
    display: none;
  }

  .mockup[data-pocket='on'] .p-pocket,
  .mockup[data-label='on'] .p-etiqueta {
    display: block;
  }

  /* Texturas por material */
  .tex {
    fill: url(#tex-lona);
  }

  .mockup[data-material='lienzo'] .tex {
    fill: url(#tex-lienzo);
  }

  .mockup[data-material='impermeable'] .tex {
    fill: url(#tex-impermeable);
  }

  .mockup[data-material='premium'] .tex {
    fill: url(#tex-premium);
  }
</style>


