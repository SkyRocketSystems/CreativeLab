---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PromoCaja from '../components/PromoCaja.astro';
import Hero from '../components/Hero.astro';
import Resumen from '../components/Resumen.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Catalogo from '../components/Catalogo.astro';
import Impacto from '../components/Impacto.astro';
import Empresas from '../components/Empresas.astro';
import Ferias from '../components/Ferias.astro';
import Footer from '../components/Footer.astro';
import ProductMockup from '../components/ProductMockup.astro';
---

<Layout title="CreativeLab — Crea el tuyo">
  <PromoCaja />
  <Header />
  <main id="contenido">
    <Ferias />
    <Hero />
    <Resumen />
    <ComoFunciona />
    <Catalogo />
    <Impacto />
    <Empresas />
  </main>
  <Footer />

  <!-- Modal de vista ampliada -->
  <div id="modal-vista" role="dialog" aria-modal="true" aria-labelledby="modal-titulo" hidden>
    <div class="modal-fondo" data-cerrar-modal></div>
    <div class="modal-caja">
      <button class="modal-cerrar" id="modal-cerrar" type="button" aria-label="Cerrar vista ampliada">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
      <h2 class="modal-titulo" id="modal-titulo">Tote bag · Natural</h2>
      <p class="modal-subtitulo">Vista ampliada de tu diseño</p>
      <div class="modal-producto">
        <ProductMockup stateful={true} product="tote" color="#E6DEC9" etiqueta="Vista ampliada de tu diseño" />
      </div>
    </div>
  </div>

  <!-- Barra sticky móvil -->
  <div id="barra-movil">
    <span class="barra-precio">
      Total: <strong id="barra-precio">$40.000 COP</strong>
    </span>
    <button class="barra-carrito" data-abrir-carrito="productos" type="button" aria-label="Carrito, 0 productos">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 8h12l-1.2 12H7.2L6 8Z"></path>
        <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
      </svg>
      <span class="barra-badge badge-carrito" data-ambito="productos" aria-hidden="true" hidden>0</span>
    </button>
    <button class="btn btn-primario" data-accion="whatsapp" type="button">Pedir por WhatsApp</button>
  </div>

  <!-- Toast global -->
  <div id="toast" role="status" aria-live="polite"></div>
</Layout>

<script src="../scripts/configurator.js"></script>

<style>
  .modal-titulo {
    font-size: 20px;
    font-weight: 700;
    padding-right: 48px;
  }

  .modal-subtitulo {
    font-size: 13px;
    color: rgba(30, 26, 24, 0.55);
    margin-top: 2px;
    margin-bottom: 12px;
  }

  .modal-producto {
    background: linear-gradient(160deg, var(--beige-suave) 0%, var(--beige) 100%);
    border-radius: var(--radius-tarjeta);
    padding: 24px;
    display: flex;
    justify-content: center;
  }

  .modal-producto :global(.mockup) {
    width: min(80%, 420px);
  }

  /* Botón del carrito en la barra sticky móvil (lo abre src/scripts/carrito.js) */
  .barra-carrito {
    position: relative;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(250, 248, 243, 0.35);
    background: rgba(250, 248, 243, 0.12);
    color: var(--crema);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform var(--mov-100) var(--curva-deceleracion);
  }

  .barra-carrito svg {
    width: 20px;
    height: 20px;
  }

  .barra-carrito:active {
    transform: scale(0.94);
  }

  .barra-carrito:focus-visible {
    outline: 2px solid var(--crema);
    outline-offset: 2px;
  }

  .barra-carrito .barra-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 18px;
    height: 18px;
    padding-inline: 4px;
    border-radius: var(--radius-pill);
    background: var(--terracota);
    color: var(--crema);
    font-size: 10.5px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

