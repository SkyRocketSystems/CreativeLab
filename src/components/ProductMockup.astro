    <div class="mockup-fotos" aria-hidden="true">
      <img class="foto foto-beige" src="/Totebags/tote-beige.png" alt="" draggable="false" decoding="async" />
      <img class="foto foto-green" src="/Totebags/tote-green.png" alt="" draggable="false" decoding="async" />
      <img class="foto foto-personalizado" src="/Totebags/tote-personalizado.png" alt="" draggable="false" decoding="async" />
